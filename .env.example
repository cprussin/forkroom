# forkroom environment variables.
# Copy to apps/web/.env.local for local development. Names and descriptions
# only — never commit real credentials.

# --- Required ---

# PostgreSQL connection string. Neon, Supabase, or a local Postgres all work.
# The app applies migrations automatically on first startup.
DATABASE_URL=

# Secret used to sign Auth.js session tokens. Generate with: openssl rand -base64 32
AUTH_SECRET=

# --- Model provider ---

# "mock" (default) streams a deterministic reply with no API key — ideal for
# local dev and tests. "anthropic" uses the real streaming API.
MODEL_PROVIDER=mock

# Model id passed to the provider (e.g. an Anthropic model for MODEL_PROVIDER=anthropic).
MODEL_NAME=claude-3-5-haiku-latest

# Required only when MODEL_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# Short neutral system prompt prepended to every generation (optional; has a default).
SYSTEM_PROMPT=

# Maximum prompt size in Unicode characters (optional; defaults to 16000).
MAX_PROMPT_CHARS=

# --- Optional OAuth (production sign-in) ---

# GitHub OAuth app credentials. When both are set, "Continue with GitHub" is enabled.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- Optional worker / cron ---

# Identifier a worker uses when claiming jobs (optional; defaults to worker-1).
WORKER_ID=

# Idle poll interval for the standalone worker, in ms (optional; defaults to 1000).
WORKER_POLL_INTERVAL_MS=

# Shared secret required on POST /api/worker/tick when set. Vercel Cron sends it
# as `Authorization: Bearer <CRON_SECRET>`. Leave unset to allow unauthenticated
# ticks in local development.
CRON_SECRET=
